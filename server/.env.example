PORT=5000
# Primary MongoDB Atlas connection string:
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vistaraone?retryWrites=true&w=majority
# Optional Local MongoDB fallback URI (used if Atlas IP whitelist is not configured):
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/vistaraone
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
